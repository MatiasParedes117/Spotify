{
  "name": "spotify-clone",
  "version": "1.0.0",
  "private": true,
  "description": "Clon visual e interactivo de Spotify (proyecto académico)",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/assets/css/input.css -o ./src/assets/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/assets/css/input.css -o ./src/assets/css/style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.2.4",
    "tailwindcss": "4.2.4"
  }
}